{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.2",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extDefaultTitle__"
  }
}