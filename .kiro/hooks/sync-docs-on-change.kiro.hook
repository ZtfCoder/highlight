{
  "enabled": true,
  "name": "Sync Documentation",
  "description": "When source files are edited, prompts the agent to review changes and update relevant documentation in README.md or the docs folder",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.js",
      "*.json",
      "*.sql",
      "*.html"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the changes made and determine if any documentation needs to be updated. If the changes affect functionality, APIs, configuration, or usage patterns, update the relevant documentation in either the README.md file or the enterprise-tools/README.md file as appropriate. Only make documentation updates if the code changes warrant it."
  }
}